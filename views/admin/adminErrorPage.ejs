
    <title>Admin - Error</title>
    <link rel="stylesheet" href="/css/style.css"> <!-- Add your CSS file -->
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #121212;
            font-family: "Poppins", sans-serif;
            text-align: center;
            color: white;
        }
        .error-container {
            background: #1e1e1e;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0px 6px 15px rgba(255, 255, 255, 0.1);
            width: 80%;
            max-width: 500px;
        }
        h1 {
            color: #ff4d4d;
            font-size: 26px;
            margin-bottom: 10px;
        }
        p {
            color: #cccccc;
            font-size: 18px;
            margin-bottom: 20px;
        }
        a {
            text-decoration: none;
            color: black;
            background: #ff4d4d;
            padding: 12px 25px;
            border-radius: 5px;
            font-weight: bold;
            display: inline-block;
            transition: all 0.3s ease;
        }
        a:hover {
            background: #ff1a1a;
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <div class="error-container">
        <h1>⚠ Oops! Something Went Wrong</h1>
        <p>The page you are looking for doesn’t exist or an error occurred.</p>
        <a href="/admin/">🔄 Go Back to Dashboard</a>
    </div>
</body>

