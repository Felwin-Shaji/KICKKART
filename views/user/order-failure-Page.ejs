                    </p>
                    <a href="/" class="btn btn-primary btn-outline-primary">Home</a>
                    <a href="/shope" class="btn btn-primary btn-outline-primary"><i class="icon-shopping-cart"></i> Continue Shopping</a>
                    <a href="/userProfile" class="btn btn-primary btn-outline-primary"><i class="icon-user"></i> Profile</a>
                </p>

                </div>
                
                    


            </div>
        </div>
    </div>
