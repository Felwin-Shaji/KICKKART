<style>
    /* Wishlist Container */
    .wishlist-container {
        background-color: #f9f9f9;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    /* Table */
    .wishlist-table {
        background-color: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
    }

    .wishlist-table table {
        margin: 0;
    }

    .wishlist-table thead th {
        background-color: #007bff;
        color: #fff;
        padding: 15px;
        text-transform: uppercase;
        font-size: 14px;
        font-weight: 600;
    }

    .wishlist-table tbody td {
        vertical-align: middle;
        font-size: 14px;
        padding: 15px;
        border: 1px solid #ddd;
    }

    /* Product Thumbnail */
    .product-thumbnail img {
        max-width: 100px;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
    }

    .product-thumbnail h4 a {
        color: #333;
        font-weight: 600;
        font-size: 16px;
        text-decoration: none;
    }

    .product-thumbnail h4 a:hover {
        color: #007bff;
    }

    /* Stock Status */
    .stock-status .badge {
        font-size: 12px;
        padding: 5px 10px;
        border-radius: 12px;
    }

    /* Buttons */
    .cart-button {
        background-color: #007bff;
        color: #fff;
        border: none;
        padding: 10px 20px;
        font-size: 14px;
        border-radius: 5px;
        transition: background-color 0.3s;
    }

    .cart-button:hover {
        background-color: #0056b3;
    }

    .btn-outline-danger {
        font-size: 12px;
        padding: 5px 10px;
        border-radius: 5px;
        transition: background-color 0.3s, color 0.3s;
    }

    .btn-outline-danger:hover {
        background-color: #ff4d4d;
        color: #fff;
    }

    /* Modal */
    .modal-content {
        border-radius: 10px;
        border: 1px solid #ddd;
    }

    .modal-header {
        background-color: #007bff;
        color: #fff;
        padding: 15px;
        border-bottom: 1px solid #ddd;
    }

    .modal-header h4 {
        font-size: 16px;
    }

    .modal-footer .btn-primary {
        background-color: #007bff;
        border: none;
        padding: 10px 20px;
    }

    .modal-footer .btn-primary:hover {
        background-color: #0056b3;
    }

    /* Empty Wishlist */
    .py-5 h5 {
        font-size: 18px;
        font-weight: 600;
        color: #666;
    }

    .py-5 .btn-primary {
        padding: 10px 20px;
        font-size: 14px;
        border-radius: 5px;
        background-color: #007bff;
        color: #fff;
        transition: background-color 0.3s;
    }

    .py-5 .btn-primary:hover {
        background-color: #0056b3;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .wishlist-container {
            padding: 15px;
        }

        .wishlist-table table {
            font-size: 12px;
        }

        .product-thumbnail img {
            max-width: 80px;
        }

        .cart-button,
        .btn-outline-danger {
            font-size: 12px;
            padding: 5px 10px;
        }

    }

    i.bi-trash,
    i.bi-x-circle {
        font-size: 20px;
        /* Adjust size */
        color: #ff4d4d;
        /* Icon color */
        cursor: pointer;
        /* Show pointer on hover */
        transition: color 0.3s ease;
        /* Smooth color transition */
    }

    i.bi-trash:hover,
    i.bi-x-circle:hover {
        color: #ff0000;
        /* Darker red on hover */
    }
</style>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
<%- include("../partials/user/header.ejs") %>
    <section class="mt-5 mb-5 wishlist-container">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12">
                    <div class="table-responsive wishlist-table">
                        <table class="table table-bordered text-center align-middle">
                            <thead>
                                <tr>
                                    <th colspan="2">Product</th>
                                    <th>Stock Status</th>
                                    <th>Action</th>

                                </tr>
                            </thead>
                            <tbody>
                                <% if (wishlist.products && wishlist.products.length> 0) { %>
                                    <% let i=0; %> <!-- Initialize i outside the loop -->
                                        <% wishlist.products.forEach(product=> { %>
                                            <tr>
                                                <td class="image product-thumbnail" data-title="Image">
                                                    <h4>
                                                        <%= product.productId.brand %>
                                                    </h4>
                                                    <a href="/productDetails?id=<%= product.productId._id %>">
                                                        <img src="/uploads/re-image/<%= product.productId.productImage[0] %>"
                                                            alt="<%= product.productId.productName %>"
                                                            class="img-fluid rounded" style="max-width: 80px;">
                                                </td></a>
                                                <td>
                                                    <h4 class="mb-0"><a
                                                            href="/productDetails?id=<%= product.productId._id %>">
                                                            <%= product.productId.productName %>
                                                        </a></h4>
                                                    <span>Sales Price :₹ <%= product.productId.salePrice %></span> <br>
                                                    <br>
                                                    Reguler Price :<del><span>₹ <%= product.productId.regularPrice %>
                                                        </span></del><br> <br>
                                                    <p class="badge bg-success p-2">Offer: <span>
                                                            <%= product.productId.isOfferActive %>%
                                                        </span></p>
                                                </td>

                                                <td class="stock-status" data-title="Stock">
                                                    <% if (product.totalQuantity> 0) { %>
                                                        <span class="badge bg-success">In Stock (Total: <%=
                                                                product.totalQuantity %>)</span>
                                                        <% } else { %>
                                                            <span class="badge bg-danger">Out of Stock</span>
                                                            <% } %>
                                                </td>

                                                <td data-title="Action">
                                                    <% if (product.totalQuantity> 0) { %>
                                                        <button class="btn btn-sm btn-primary cart-button"
                                                            data-product-id="<%= product.productId._id %>"
                                                            data-bs-toggle="modal" data-bs-target="#sizeModal-<%= i %>">
                                                            <i class="bi bi-cart-plus"></i></i>
                                                        </button>
                                                        <% } else { %>
                                                            <button class="btn btn-sm btn-primary cart-button"
                                                                data-product-id="<%= product.productId._id %>"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#sizeModal-<%= i %>" disabled>
                                                                <i class="bi bi-cart-plus"></i></i>
                                                            </button>
                                                            <% } %>
                                                                <button class="btn btn-sm display"
                                                                    onclick="removeFromWishlist('<%= product.productId._id %>')">
                                                                    <i class="bi bi-x-circle"></i>
                                                                </button>
                                            </tr>

                                            <!-- Size Modal for Each Product -->
                                            <div id="sizeModal-<%= i %>" class="modal fade" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h4 class="modal-title">Select Size</h4>
                                                            <button type="button" class="btn-close"
                                                                data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="size-wrap">
                                                                <div class="block-26 mb-2">
                                                                    <h5>Available Sizes</h5>
                                                                    <ul
                                                                        class="size-options list-unstyled d-flex flex-wrap">
                                                                        <% product.productId.variants.forEach(({ size
                                                                            })=> { %>
                                                                            <li class="variant-option px-2 py-1 border rounded me-2 mb-2"
                                                                                data-size="<%= size %>">
                                                                                <%= size %>
                                                                            </li>
                                                                            <% }); %>
                                                                    </ul>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button id="modalOkButton-<%= i %>"
                                                                class="btn btn-primary modal-ok"
                                                                data-product-id="<%= product.productId._id %>">OK</button>
                                                            <button type="button" class="btn-cancle btn-secondary"
                                                                data-bs-dismiss="modal">Cancel</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <% i++; %> <!-- Increment i after each iteration -->
                                                <% }); %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="6" class="text-center">
                                                                <div class="py-5">
                                                                    <h5>Your wishlist is empty.</h5>
                                                                    <a href="/" class="btn btn-primary mt-3">Start
                                                                        Shopping</a>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>


    </main>
    <%- include("../partials/user/footer.ejs") %>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            const removeFromWishlist = async (productId) => {
                try {
                    const response = await fetch('/wishlist/remove', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ productId }), // Sending productId to the server
                    });

                    const data = await response.json(); // Parsing the JSON response

                    if (data.success) {
                        // Show success SweetAlert
                        Swal.fire({
                            icon: 'success',
                            title: 'Removed!',
                            text: data.message,
                            showConfirmButton: false,
                            timer: 1500,
                        }).then(() => {
                            // Remove the item from the DOM
                            const itemElement = document.getElementById(`wishlist-item-${productId}`);
                            if (itemElement) {
                                itemElement.remove();
                            }
                            // Redirect to the wishlist page
                            window.location = "/wishlist";
                        });
                    } else {
                        // Show error SweetAlert
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: data.message,
                            confirmButtonText: 'OK',
                        });
                    }
                } catch (error) {
                    console.error("Error removing item from wishlist:", error);

                    // Show error SweetAlert for unexpected issues
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops!',
                        text: 'An error occurred. Please try again.',
                        confirmButtonText: 'OK',
                    });
                }
            };


            document.addEventListener("DOMContentLoaded", () => {
                // Attach event listeners for cart buttons using delegation
                document.querySelectorAll('.cart-button').forEach((button, index) => {
                    button.addEventListener('click', function () {
                        const productId = this.dataset.productId;
                        const modal = document.getElementById(`sizeModal-${index}`);
                        const okButton = modal.querySelector(`#modalOkButton-${index}`);
                        const closeButton = modal.querySelector('.btn-close');
                        const cancelButton = modal.querySelector('.btn-cancle');
                        let selectedSize = null;

                        // Show modal using Bootstrap
                        const bootstrapModal = new bootstrap.Modal(modal);
                        bootstrapModal.show();

                        // Handle size selection
                        modal.querySelectorAll('.variant-option').forEach(option => {
                            option.addEventListener('click', function () {
                                modal.querySelectorAll('.variant-option').forEach(opt => opt.classList.remove('selected'));
                                this.classList.add('selected');
                                selectedSize = this.dataset.size;
                            });
                        });

                        // OK Button Logic
                        okButton.addEventListener('click', async () => {
                            if (selectedSize) {
                                try {
                                    const response = await fetch('/cart', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ productId, selectedSize, quantity: "1" }),
                                    });

                                    if (response.ok) {
                                        Swal.fire({
                                            icon: 'success',
                                            title: 'Success!',
                                            text: 'Item added to cart successfully!',
                                            showConfirmButton: false,
                                            timer: 1500,
                                        }).then(() => {
                                            location.reload(); // Or dynamically update cart items
                                        });
                                        bootstrapModal.hide();
                                    } else {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'Error!',
                                            text: 'Failed to add item to cart.',
                                        });
                                    }
                                } catch (error) {
                                    console.error('Error:', error);
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error!',
                                        text: 'An unexpected error occurred.',
                                    });
                                }
                            } else {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Oops...',
                                    text: 'Please select a size before proceeding!',
                                });
                            }
                        });

                        // Close & Cancel Button Logic
                        const closeModal = () => {
                            bootstrapModal.hide();
                            location.reload(); // Or reset modal state without reload
                        };

                        closeButton.addEventListener('click', closeModal);
                        if (cancelButton) {
                            cancelButton.addEventListener('click', closeModal);
                        }
                    });
                });
            });
        </script>