<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<style>
    /* General styles */
    body {
        font-family: "Arial", sans-serif;
        width: 100%;

    }

    /* Sticky search bar */
    .search-container {
        position: sticky;
        justify-items: end;
        top: 0;
        z-index: 1000;
        background-color: #ffffff00;

        /* margin-left: 40%; */
    }

    .search-container form {
        margin-left: 0%;
        width: 75%;
        padding-left: 10%;
    }

    .search-container h1 {
        margin-left: 17%;
    }

    /* Sidebar styles */
    .sidebar {
        position: sticky;
        top: 70px;
        /* Adjust based on your header height */
        max-width: 300px;
        width: 100%;
    }

    .variant-option.active {
        background-color: #007bff;
        /* Blue background */
        color: white;
        /* White text */
        border-color: #007bff;
        /* Blue border */
    }


    .filterButtom {
        background-color: #e0e0e000;
        padding: 5px 10px;
        width: 90%;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease, border 0.3s ease;
    }

    .filterButtom:hover {
        background-color: #67b3ff59;
        border: none;
    }


    @media (max-width: 991px) {
        .sidebar {
            position: static;
            margin-bottom: 20px;
        }
    }

    /* Product card styles */
    .product-card {
        transition: transform .3s ease, box-shadow 0.3s ease;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    /* ///////////////////////////////////////////////////////// */

    /* .product-card img {
            height: 200px;
            object-fit: cover;
        } */

    /* ///////////////////////////////////////////////////////////// */

    /* Responsive adjustments */
    @media (max-width: 767px) {
        .col-md-6.col-lg-3 {
            width: 50%;
        }
    }

    @media (max-width: 575px) {
        .col-md-6.col-lg-3 {
            width: 100%;
        }
    }

    /* Pagination styles */
    .pagination {
        flex-wrap: wrap;
    }

    /* .text-primary{
            background: #00000000;
        } */

    .text-primary-filter {
        text-decoration: none;
        background: linear-gradient(45deg, #3595fc, #2b70ba);
        color: white;
        margin-bottom: 5px;
        padding: 5px 10px;
        border-radius: 8px;
        font-size: 1.3rem;
        text-align: center;
    }

    .filter-button {
        border: none;
        border-radius: 8px;
        padding: 5px 10px;
        width: 100%;
        margin-bottom: 0px;
        background-color: white;

        transition: background-color 0.3s, color 0.3s;
    }

    .filter-button a {
        color: #000000;
    }

    .filter-button.active,
    .filter-button:hover {
        background-color: #88c1fe;
        color: rgb(0, 0, 0);
    }





    .parent-container {
            overflow: visible;
            /* Ensure modal is fully visible */
        }

        .modal-content {
            width: 90%;
            max-width: 400px;
            padding: 20px;
            background: transparent;
            /* Fully transparent background */
            color: #ffffff;
            border-radius: 8px;
            box-shadow: none;
            /* Remove shadow */
            text-align: center;
        }

        
        /* Modal transparency adjustments */
        .modal {
            background: rgba(0, 0, 0, 0);
            /* Transparent background with a subtle black overlay */
        }

        .modal-dialog {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            /* Center vertically */
        }

        .modal-header,
        .modal-footer {
            background: rgba(0, 0, 0, 0.356);

            border: none;
            /* Remove default borders */
        }

        .modal-title {
            color: #ffffff;
            /* Ensure title is visible on transparent background */
        }



    .size-options {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .variant-option {
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .variant-option:hover {
        background-color: #f8f9fa;
    }


    /* Enhance discount badge visibility */
    .discount-badge {
        font-weight: bold;
    }

    /* Responsive grid adjustments */
    @media (min-width: 576px) {
        .col-sm-6 {
            flex: 0 0 auto;
            width: 50%;
        }
    }

    @media (min-width: 768px) {
        .col-md-4 {
            flex: 0 0 auto;
            width: 33.33333%;
        }
    }

    @media (min-width: 992px) {
        .col-lg-3 {
            flex: 0 0 auto;
            width: 25%;
        }
    }

    /* Improve spacing and alignment*/
    .container-fluid {
        padding-left: 15px;
        padding-right: 15px;
    }

    /* Row gap */
    .row {
        gap: 0px;
    }

    /* Enhance sidebar responsiveness */
    @media (max-width: 991px) {
        .sidebar {
            max-width: 100%;
            margin-bottom: 20px;
        }
    }

    /* Improve modal responsiveness */
    @media (max-width: 576px) {
        .modal-content {
            width: 95%;
        }
    }

    html {
        scroll-behavior: smooth;
    }
</style>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
<!-- <link rel="stylesheet" href="styles.css"> -->
<%- include("../partials/user/header.ejs") -%>

    <body>
        <div class="container-fluid"> <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mt-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active">Shop</li>
                </ol>
            </nav>
            <div class="row">
                <!-- Search Bar -->


                <div class="search-container sticky-top bg-white p-2 d-flex  ">
                    <!-- Button to navigate to All Products -->

                    <% if (category.length> 0) { %> <!-- Check if the category array is not empty -->
                        <% let matchFound=false; %> <!-- Flag to track if a match is found -->
                            <% for (let i=0; i < category.length; i++) { %> <!-- Loop through the categories -->
                                <% if (selectedCategory==category[i]._id) { %>
                                    <!-- Check if this is the selected category -->
                                    <h1>
                                        <%= category[i]?.name %>
                                    </h1> <!-- Display the name of the selected category -->
                                    <% matchFound=true; %> <!-- Set flag to true if a match is found -->
                                        <% } %>
                                            <% } %>
                                                <% if (!matchFound) { %> <!-- If no match is found, display fallback -->
                                                    <h1>Shop</h1>
                                                    <% } %>
                                                        <% } else { %> <!-- If the category array is empty -->
                                                            <h1>Shop</h1>
                                                            <% } %>


                                                                <!-- Search Form -->
                                                                <form action="/search" method="post"
                                                                    class="search-form w-50">
                                                                    <div class="input-group">
                                                                        <input type="text"
                                                                            class="form-control search-input"
                                                                            name="search"
                                                                            placeholder="<%= searchedProduct ? searchedProduct : 'Search for items...' %>"
                                                                            aria-label="Search for items">
                                                                        <button type="submit"
                                                                            class="input-group-text bg-primary text-white">
                                                                            <i class="bi bi-search"></i>
                                                                        </button>
                                                                    </div>
                                                                </form>
                </div>



                <!-- Sidebar -->
                <div class="col-4 col-lg-2">
                    <div class="sidebar border rounded p-3 shadow-sm bg-white">
                        <!-- Categories -->
                        <h5 id="category-heading" class="text-primary-filter ">Category</h5>
                        <ul id="category-list" class="list-unstyled">
                            <% for(let i=0; i < category.length; i++) { %>
                                <li class="mb-2">
                                    <button
                                        class="filter-button <%= selectedCategory == category[i]._id ? 'active' : '' %>">
                                        <a href="/filter?category=<%= category[i]._id %>" class="text-decoration-none">
                                            <%= category[i].name %>
                                        </a>
                                    </button>
                                </li>
                                <% } %>
                        </ul>

                        <!-- Brands -->
                        <h5 id="brand-heading" class="text-primary-filter ">Brands</h5>
                        <ul id="brand-list" class="list-unstyled">
                            <% for(let i=0; i < brand.length; i++) { %>
                                <li class="mb-2">
                                    <button class="filter-button <%= selectedBrand == brand[i]._id ? 'active' : '' %>">
                                        <a href="/filter?brand=<%= brand[i]._id %>" class="text-decoration-none">
                                            <%= brand[i].brandName %>
                                        </a>
                                    </button>
                                </li>
                                <% } %>
                        </ul>

                        <!-- Price Filters -->
                        <!-- Price Filters -->
                        <!-- Price Filters -->
                        <h5 id="price-heading" class="text-primary-filter">Filter by Price</h5>
                        <ul id="price-list" class="list-unstyled">
                            <li class="mb-2">
                                <button class="filter-button <%= selectedPrice === '0-2000' ? 'active' : '' %>">
                                    <a href="/filter?category=<%= selectedCategory %>&brand=<%= selectedBrand %>&gt=0&lt=2000"
                                        class="text-decoration-none">Below ₹2000</a>
                                </button>
                            </li>
                            <li class="mb-2">
                                <button class="filter-button <%= selectedPrice === '2000-6000' ? 'active' : '' %>">
                                    <a href="/filter?category=<%= selectedCategory %>&brand=<%= selectedBrand %>&gt=2000&lt=6000"
                                        class="text-decoration-none">₹2000 - ₹6000</a>
                                </button>
                            </li>
                            <li class="mb-2">
                                <button class="filter-button <%= selectedPrice === '6000-10000' ? 'active' : '' %>">
                                    <a href="/filter?category=<%= selectedCategory %>&brand=<%= selectedBrand %>&gt=6000&lt=10000"
                                        class="text-decoration-none">₹6000 - ₹10000</a>
                                </button>
                            </li>
                            <li class="mb-2">
                                <button class="filter-button <%= selectedPrice === '10000-9999999' ? 'active' : '' %>">
                                    <a href="/filter?category=<%= selectedCategory %>&brand=<%= selectedBrand %>&gt=10000&lt=9999999"
                                        class="text-decoration-none">Above ₹10000</a>
                                </button>
                            </li>
                        </ul>



                        <!-- Clear Filters -->
                        <button class="btn btn-danger w-100 mt-3">
                            <a href="/shope" class="text-white text-decoration-none">Clear All Filters</a>
                        </button>
                    </div>
                </div>



                <!-- Main Content -->
                <div class="col-10 col-md-10"> <!-- Products Grid -->
                    <div class="d-flex justify-content-end align-items-center mb-3">
                        <p class="mb-0 me-2"><b>Sort by:</b></p>
                        <select id="sort-options" class="form-select w-auto" onchange="applySorting(this.value)">
                            <option value="priceLowToHigh" <%=selectedSort==='priceLowToHigh' ? 'selected' : '' %>
                                >Price: Low to High</option>
                            <option value="priceHighToLow" <%=selectedSort==='priceHighToLow' ? 'selected' : '' %>
                                >Price: High to Low</option>
                            <option value="Aa-Zz" <%=selectedSort==='Aa-Zz' ? 'selected' : '' %>>Aa-Zz</option>
                            <option value="Zz-Aa" <%=selectedSort==='Zz-Aa' ? 'selected' : '' %>>Zz-Aa</option>
                        </select>

                    </div>

                    <div class="row g-3"> <!-- Product Card -->
                        <% for(let i=0; i<products.length; i++) { %>
                            <div class="col-md-3 col-lg-3">
                                <div class="product-card shadow-sm border rounded">
                                    <div class="position-relative">
                                        <!-- <span class="hot-badge">Hot</span> -->
                                        <a href="/productDetails?id=<%=products[i]._id %>">
                                            <img src="/uploads/re-image/<%= products[i].productImage[0] %>"
                                                class="card-img-top" alt="<%= products[i].productName %>">
                                        </a>
                                    </div>
                                    <div class="card-body text-center">
                                        <h5 class="card-title text-primary">
                                            <%= products[i].brand %>
                                        </h5>
                                        <h6 class="card-title">
                                            <%= products[i].productName %>
                                        </h6>
                                        <div class="d-flex align-items-center justify-content-center mb-2">
                                            <div class="star-rating me-2">
                                                <i class="bi bi-star-fill text-warning"></i>
                                                <i class="bi bi-star-fill text-warning"></i>
                                                <i class="bi bi-star-fill text-warning"></i>
                                                <i class="bi bi-star-fill text-warning"></i>
                                                <i class="bi bi-star text-secondary"></i>
                                            </div>
                                            <span class="discount-badge bg-success text-white px-2 py-1 rounded">
                                                <%=products[i].isOfferActive %>%
                                                    Off
                                            </span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-end"
                                            style="margin-left: 10%;">
                                            <div>
                                                <span class="h5 text-primary mb-0">
                                                    ₹<%= Number(products[i].salePrice).toLocaleString("en-IN") %>
                                                </span>
                                                <span
                                                    class="original-price ms-2 text-muted text-decoration-line-through">
                                                    ₹<%= Number(products[i].regularPrice).toLocaleString("en-IN") %>
                                                </span>
                                            </div>
                                            <% if (!locals.user) { %>
                                                <a href="/login">
                                                    <button class="btn btn-outline-primary cart-button">
                                                        <i class="bi bi-cart-plus"></i>
                                                    </button>
                                                </a>
                                                <a href="/login">
                                                    <button class="btn btn-outline-secondary wish-button">
                                                        <i class="fa-regular fa-heart"></i>
                                                    </button></a>
                                                <% } else { %>
                                                    <button class="btn btn-outline-primary cart-button"
                                                        data-product-id="<%= products[i]._id %>" data-bs-toggle="modal"
                                                        data-bs-target="#sizeModal-<%= i %>">
                                                        <i class="bi bi-cart-plus"></i>
                                                    </button>

                                                    <button class="btn btn-outline-secondary wish-button"
                                                        data-product-wish-id="<%= products[i]._id %>">
                                                        <i class="fa-regular fa-heart"></i>
                                                    </button>

                                                    <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Modal Structure -->
                            <div id="sizeModal-<%= i %>" class="modal fade" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h4 class="modal-title">Select Size</h4>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="size-wrap">
                                                <div class="block-26 mb-2">
                                                    <h5>Available Sizes</h5>
                                                    <ul class="size-options list-unstyled d-flex flex-wrap">
                                                        <% products[i].variants.forEach(({ size })=> { %>
                                                            <li class="variant-option px-2 py-1 border rounded me-2 mb-2"
                                                                data-size="<%= size %>">
                                                                <%= size %>
                                                            </li>
                                                            <% }); %>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button id="modalOkButton-<%= i %>" class="btn btn-primary modal-ok"
                                                data-product-id="<%= products[i]._id %>">OK</button>
                                            <button type="button" class="btn-cancle btn-secondary"
                                                data-bs-dismiss="modal">Cancel</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                    </div> <!-- Pagination -->
                    <div class="pagination d-flex justify-content-center mt-4">
                        <% if (currentPage> 1) { %>
                            <a class="btn btn-outline-primary mx-1" href="/shope?page=<%= currentPage - 1 %>">Prev</a>
                            <% } %>
                                <% for (let i=1; i <=totalpages; i++) { %>
                                    <a class="btn <%= currentPage === i ? 'btn-primary' : 'btn-outline-primary' %> mx-1"
                                        href="/shope?page=<%= i %>">
                                        <%= i %>
                                    </a>
                                    <% } %>
                                        <% if (currentPage < totalpages) { %>
                                            <a class="btn btn-outline-primary mx-1"
                                                href="/shope?page=<%= currentPage + 1 %>">Next</a>
                                            <% } %>
                    </div>
                </div>
            </div>
        </div>

    </body>

    <%- include("../partials/user/footer.ejs") -%>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>

            document.addEventListener('DOMContentLoaded', () => {
                // Select all size options
                const sizeModals = document.querySelectorAll('.size-options');

                sizeModals.forEach((modal) => {
                    modal.addEventListener('click', (event) => {
                        const target = event.target;

                        // Check if a size button was clicked
                        if (target.classList.contains('variant-option')) {
                            // Remove active class from all options in this modal
                            modal.querySelectorAll('.variant-option').forEach((btn) => {
                                btn.classList.remove('active');
                            });

                            // Add active class to the clicked button
                            target.classList.add('active');
                        }
                    });
                });
            });
            document.getElementById('category-heading').onclick = function () {
                var categoryList = document.getElementById('category-list');
                categoryList.style.display = categoryList.style.display === 'none' ? 'block' : 'none';
            };
            document.getElementById('brand-heading').onclick = function () {
                var brandList = document.getElementById('brand-list');
                brandList.style.display = brandList.style.display === 'none' ? 'block' : 'none';
            };
            document.getElementById('price-heading').onclick = function () {
                var priceList = document.getElementById('price-list');
                priceList.style.display = priceList.style.display === 'none' ? 'block' : 'none';
            };

            function applySorting(sortValue) {
                const urlParams = new URLSearchParams();
                urlParams.set('sort', sortValue); // Add or update the 'sort' query parameter
                window.location.href = `/filter?${urlParams.toString()}`; // Redirect to /filter with updated query parameters
            }



            //wishlist
            document.addEventListener("DOMContentLoaded", () => {

                const wishButtons = document.querySelectorAll(".wish-button");


                wishButtons.forEach(button => {
                    button.addEventListener("click", async (event) => {

                        const productId = button.getAttribute("data-product-wish-id");

                        try {
                            const response = await fetch("/wishlist", {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({ productId })
                            });

                            if (response.ok) {
                                const result = await response.json();
                                console.log(result.message);
                            } else {
                                console.error("Failed to add to wishlist");
                            }
                        } catch (error) {
                            console.error("Error:", error);
                        }
                    });
                });
            });

            document.addEventListener("DOMContentLoaded", () => {
                document.querySelectorAll('.cart-button').forEach((button, index) => {
                    button.addEventListener('click', function () {
                        const productId = this.dataset.productId;
                        const modal = document.getElementById(`sizeModal-${index}`);
                        const okButton = modal.querySelector(`#modalOkButton-${index}`);
                        const closeButton = modal.querySelector('.btn-close');
                        const cancelButton = modal.querySelector('.btn-cancle');
                        let selectedSize = null;

                        // Show modal using Bootstrap
                        const bootstrapModal = new bootstrap.Modal(modal);
                        bootstrapModal.show();

                        // Handle size selection
                        modal.querySelectorAll('.variant-option').forEach(option => {
                            option.addEventListener('click', function () {
                                modal.querySelectorAll('.variant-option').forEach(opt => opt.classList.remove('selected'));
                                this.classList.add('selected');
                                selectedSize = this.dataset.size;
                            });
                        });

                        // OK button logic
                        okButton.addEventListener('click', async () => {
                            if (selectedSize) {
                                try {
                                    const response = await fetch('/cart', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ productId, selectedSize, quantity: 1 }),
                                    });
                                    if (response.ok) {
                                        Swal.fire({
                                            icon: 'success',
                                            title: 'Success!',
                                            text: 'Item added to cart successfully!',
                                            showConfirmButton: false,
                                            timer: 1500,
                                        }).then(() => {
                                            location.reload();
                                        });
                                        bootstrapModal.hide();
                                    } else {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'Error!',
                                            text: 'Failed to add item to cart.',
                                        });
                                    }
                                } catch (error) {
                                    console.error('Error:', error);
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error!',
                                        text: 'An unexpected error occurred.',
                                    });
                                }
                            } else {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Oops...',
                                    text: 'Please select a size before proceeding!',
                                });
                            }
                        });

                        // Close button logic
                        closeButton.addEventListener('click', () => {
                            bootstrapModal.hide();
                            location.reload();
                        });

                        // Cancel button logic
                        if (cancelButton) {
                            cancelButton.addEventListener('click', () => {
                                bootstrapModal.hide();
                                location.reload();
                            });
                        }
                    });
                });
            });

        </script>