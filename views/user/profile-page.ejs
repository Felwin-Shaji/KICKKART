<%- include("../../views/partials/user/header") %>

  <!-- Include SweetAlert2 via CDN -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


  <style>
    .card-green {
      background-color: #f9f9f9;
    }

    .main {
      padding: 20px 0;
    }

    .dashboard-menu {
      background-color: #f0f0f0;
      border-radius: 10px;
      padding: 10px;
      color: #333;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .dashboard-menu .nav-link {
      font-weight: bold;
      color: #007bff;
      transition: color 0.3s ease;
    }

    .dashboard-menu .nav-link:hover {
      color: #0056b3;
    }

    .card {
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      margin-bottom: 15px;
      background-color: #ffffff;
    }

    .card-header {
      background-color: #e9ecef;
      color: #333;
      border-radius: 10px 10px 0 0;
      padding: 10px;
    }

    .btn-success {
      background-color: #28a745;
      border-color: #28a745;
    }

    .btn-success:hover {
      background-color: #218838;
    }

    .form-group {
      margin-bottom: 15px;
    }

    .required {
      color: red;
    }

    @media (max-width: 768px) {
      .dashboard-menu {
        padding: 8px;
      }

      .card {
        margin-bottom: 10px;
      }
    }

    .page-header.breadcrumb-wrap {
      background-color: #f8f9fa;
      padding: 10px 0;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      font-family: 'Arial', sans-serif;
      font-size: 14px;
      color: #6c757d;
    }

    .breadcrumb a {
      color: #007bff;
      text-decoration: none;
      margin: 0 5px;
    }

    .breadcrumb a:hover {
      color: #0056b3;
    }

    .breadcrumb span {
      margin: 0 5px;
      color: #6c757d;
    }
  </style>


  <main class="main">
    <!-- <div class="page-header breadcrumb-wrap mb-3">
      <div class="container">
        <div class="breadcrumb">
          <a href="#" rel="nofollow">Home</a>
          <span></span> Profile <span></span> Account
        </div>
      </div>
    </div> -->

    <section class="pt-10 pb-10">
      <div class="container">
        <div class="row">
          <div class="col-lg-10 m-auto">
            <div class="row">
              <div class="col-md-3">
                <div class="dashboard-menu">
                  <ul class="nav flex-column" role="tablist">
                    <li class="nav-item">
                      <a class="nav-link active" id="dashboard-tab" data-bs-toggle="tab" href="#dashboard" role="tab"
                        aria-controls="dashboard" aria-selected="false">
                        <i class="fi-rs-settings-sliders mr-10"></i>Dashboard
                      </a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" id="address-tab" data-bs-toggle="tab" href="#address" role="tab"
                        aria-controls="address" aria-selected="true">
                        <i class="fi-rs-marker mr-10"></i>My Address
                      </a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" id="orders-tab" data-bs-toggle="tab" href="#orders" role="tab"
                        aria-controls="orders" aria-selected="false">
                        <i class="fi-rs-shopping-bag mr-10"></i>Orders
                      </a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" id="track-orders-tab" data-bs-toggle="tab" href="#track-orders" role="tab"
                        aria-controls="track-orders" aria-selected="false">
                        <i class="fi-rs-shopping-cart-check mr-10"></i>Wallet Status
                      </a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" id="track-orders-tab" data-bs-toggle="tab" href="#wallet-history" role="tab"
                        aria-controls="track-orders" aria-selected="false">
                        <i class="fi-rs-shopping-cart-check mr-10"></i>Wallet History
                      </a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" id="track-orders-tab" data-bs-toggle="tab" href="#referal" role="tab"
                        aria-controls="track-orders" aria-selected="false">
                        <i class="fi-rs-shopping-cart-check mr-10"></i>Referals
                      </a>
                    </li>
                  </ul>
                </div>
              </div>
              <div class="col-md-9">
                <div class="tab-content dashboard-content">

                  <!-- /////////////////////////////////////////////////// -->

                  <div class="tab-pane fade show active" id="dashboard" role="tabpanel" aria-labelledby="dashboard-tab">
                    <div class="card card-green">
                      <div class="card-header">
                        <h5 class="mb-0 text-center">User Profile</h5>
                      </div>
                      <div class="card-body text-center">
                        <p class="card-text">
                          <strong><b>Name:</b>
                            <%= user.name %>
                          </strong>
                        </p>
                        <p class="card-text">
                          <strong><b>Phone:</b>
                            <%= user.phone %>
                          </strong>
                        </p>
                        <p class="card-text">
                          <strong><b>Email:</b>
                            <%= user.email %>
                          </strong>
                        </p>

                        <button type="button" class="bbtn btn-sm btn-success" data-toggle="modal"
                          data-target="#editProfileModalCenter">
                          Edit Profile
                        </button>

                        <button type="button" class="bbtn btn-sm btn-success" data-toggle="modal"
                          data-target="#exampleModalCenter">
                          Change Password
                        </button>

                      </div>
                    </div>
                  </div>

                  <!-- ///////////////////////////////////////// -->

                  <!-- Edit Profile modal -->
                  <div class="modal fade" id="editProfileModalCenter" tabindex="-1" role="dialog"
                    aria-labelledby="editProfileModalCenterTitle" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                      <div class="modal-content">
                        <!-- Modal Header -->
                        <div class="modal-header bg-success text-white">
                          <h5 class="modal-title" id="editProfileModalCenterTitle">Edit Your Profile</h5>
                          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                          </button>
                        </div>
                        <!-- Modal Body -->
                        <div class="modal-body">
                          <p class="text-muted text-center">Update your details below and click save to apply changes.
                          </p>
                          <form id="editProfileForm" novalidate>
                            <!-- Name Field -->
                            <div class="form-group">
                              <label for="userName" class="font-weight-bold">Name</label>
                              <input type="text" class="form-control shadow-sm" id="userName" value="<%= user.name %>"
                                required>
                              <small id="nameError" class="form-text text-danger d-none">Please enter a valid name
                                (minimum 3 characters).</small>
                            </div>
                            <!-- Phone Field -->
                            <div class="form-group">
                              <label for="userPhone" class="font-weight-bold">Phone</label>
                              <input type="text" class="form-control shadow-sm" id="userPhone" value="<%= user.phone %>"
                                required>
                              <small id="phoneError" class="form-text text-danger d-none">Please enter a valid 10-digit
                                phone number.</small>
                            </div>
                          </form>
                        </div>
                        <!-- Modal Footer -->
                        <div class="modal-footer d-flex justify-content-between">
                          <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
                          <button type="button" id="saveChangesButton" class="btn btn-success">Save Changes</button>
                        </div>
                      </div>
                    </div>
                  </div>


                  <!-- ChangePass modal-->
                  <div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog"
                    aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                      <div class="modal-content card">
                        <div class="modal-header card-header">
                          <h5 class="modal-title" id="exampleModalLongTitle">Reset Password</h5>
                          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                          </button>
                        </div>
                        <div class="modal-body card-green">
                          <form id="changePassword">
                            <div class="form-group">
                              <label for="password">Current Password <span class="required">*</span></label>
                              <input type="password" id="currPassword" name="currPassword" minlength="8"
                                class="form-control" required>
                            </div>
                            <div class="form-group">
                              <label for="password">New Password <span class="required">*</span></label>
                              <input type="password" id="password" name="password" minlength="8" class="form-control"
                                required>
                            </div>
                            <div class="form-group">
                              <label for="confirm-password">Confirm Password <span class="required">*</span></label>
                              <input type="password" id="confirm-password" name="confirm-password" class="form-control"
                                required>
                            </div>
                            <button type="submit" class="btn btn-success">Set New Password</button>
                          </form>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                        </div>
                      </div>
                    </div>
                  </div>



                  <div class="tab-pane fade" id="address" role="tabpanel" aria-labelledby="address-tab">
                    <div class="row">
                      <% if (addresses && addresses.length> 0) { %>
                        <% addresses.forEach(address=> { %>
                          <!-- Display each address -->
                          <div class="col-lg-6">
                            <div class="card mb-3 mb-lg-0">
                              <div class="card-header">
                                <h5 class="mb-0">
                                  <%= address.addressType %>
                                </h5>
                              </div>
                              <div class="card-body">
                                <address>
                                  <b>
                                    <%= address.name %>
                                  </b><br>
                                  <%= address.city %>, <%= address.landMark %>, <%= address.state %><br>
                                        <%= address.pincode %><br>
                                          <b>Phone:</b>
                                          <%= address.phone %><br>
                                            <b>Alt Phone:</b>
                                            <%= address.altPhone %>
                                </address>
                                <div class="d-flex justify-content-between mt-3">
                                  <a href="/editAddress?id=<%= address._id %>"
                                    class="btn btn-small btn-warning">Edit</a>
                                  <button type="button" class="btn btn-danger"
                                    onclick="confirmDelete('/deleteAddress?id=<%= address._id %>')">
                                    Delete
                                  </button>
                                </div>
                              </div>
                            </div>
                          </div>
                          <% }) %>
                            <% } else { %>
                              <!-- No address found -->
                              <div class="col-lg-6">
                                <div class="card mb-3 mb-lg-0">
                                  <div class="card-header">
                                    <h5 class="mb-0">No Address Available</h5>
                                  </div>
                                  <div class="card-body">
                                    <address>No address data found.</address>
                                  </div>
                                </div>
                              </div>
                              <% } %>
                    </div>

                    <!-- Add Address Button -->
                    <div class="btn-small col-sm-4 mt-3">
                      <a href="/addAddress?redirectTo=userProfile">
                        <button class="btn btn-primary w-100">Add Address</button>
                      </a>
                    </div>
                  </div>






                  <div class="tab-pane fade" id="orders" role="tabpanel" aria-labelledby="orders-tab">
                    <div class="card">
                      <div class="card-header">
                        <h5 class="mb-0">Your Orders</h5>
                      </div>
                      <div class="card-body">
                        <div class="table-responsive">
                          <table class="table">
                            <thead>
                              <tr>
                                <th>Date</th>
                                <th>No of Products</th>
                                <th>Total</th>
                                <th>Actions</th>
                              </tr>
                            </thead>
                            <% if (orders?.length> 0) { %>
                              <% orders.forEach(order=> { %>
                                <tbody>
                                  <tr>
                                    <td>
                                      <%= new Date(order.createdAt).toLocaleDateString("en-IN", { day: "2-digit" ,
                                        month: "2-digit" , year: "numeric" }) %>
                                    </td>

                                    <td>
                                      <%=order.items.length %>
                                    </td>
                                    <td>₹<%=order.totalAmount %>
                                    </td>
                                    <td>
                                      <% if (order.paymentStatus === "failed") { %>
                                        <button class="btn btn-warning btn-sm retry-payment" data-order-id="<%= order._id %>">Retry</button>
                                      <% } else { %>
                                        <a href="/viewOrderDetails/<%= order._id %>/123456" class="btn btn-primary btn-sm">View</a>
                                      <% } %>
                                    </td>
                                    
                                  </tr>
                                </tbody>
                                <% }); %>
                                  <% } else { %>
                                    <tr>
                                      <td colspan="5">No orders found.</td>
                                    </tr>
                                    <% } %>
                          </table>
                        </div>
                      </div>
                    </div>
                  </div>


                  <div class="tab-pane fade" id="track-orders" role="tabpanel" aria-labelledby="track-orders-tab">
                    <div class="card">
                      <div class="card-header">
                        <h5 class="mb-0">Wallet</h5>
                      </div>
                      <div class="card-body contact-from-area">
                        <div class="row">
                          <div class="col-lg-8 mx-auto text-center mt-90">
                            <form>
                              <div class="form-group">
                                <label for="walletAmount" class="h4">Amount</label>
                                <div class="h3">₹<%=user.wallet?.balance %>
                                </div>
                              </div>
                              <button type="button" class="btn btn-success" data-toggle="modal"
                                data-target="#addMoneyModal">
                                Add Money
                              </button>
                            </form>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>


                  <!-- add money to wallet -->
                  <div class="modal fade" id="addMoneyModal" tabindex="-1" role="dialog"
                    aria-labelledby="addMoneyModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="addMoneyModalLabel">Add Money to Wallet</h5>
                          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                          </button>
                        </div>
                        <div class="modal-body">
                          <form id="addMoneyForm">
                            <div class="form-group">
                              <label for="walletAmount" class="h4">Amount</label>
                              <input type="number" id="walletAmount" class="form-control" placeholder="Enter amount"
                                required>
                            </div>
                            <div class="form-group text-center">
                              <button type="button" class="btn btn-success" onclick="initiatePayment()">Add
                                Money</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  </div>


                  <div class="tab-pane fade" id="wallet-history" role="tabpanel" aria-labelledby="orders-tab">
                    <div class="card">
                      <div class="card-header">
                        <h5 class="mb-0">Wallet History</h5>
                      </div>
                      <div class="card-body">
                        <div class="table-responsive">
                          <table class="table">
                            <thead>
                              <tr>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Amount</th>
                              </tr>
                            </thead>
                            <tbody>
                              <% if (walletHistory.length> 0) { %>
                                <% walletHistory.forEach(function(transaction) { %>
                                  <tr>
                                    <td>
                                      <%= new Date(transaction.date).toLocaleDateString() %>
                                    </td>
                                    <td>
                                      <%= transaction.type.charAt(0).toUpperCase() + transaction.type.slice(1) %>
                                    </td>
                                    <td>
                                      <%= transaction.amount %>
                                    </td>
                                  </tr>
                                  <% }); %>
                                    <% } else { %>
                                      <tr>
                                        <td colspan="3" class="text-center">No wallet transactions available.</td>
                                      </tr>
                                      <% } %>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="tab-pane fade" id="referal" role="tabpanel" aria-labelledby="track-orders-tab">
                    <div class="card">
                      <div class="card-header">
                        <h5 class="mb-0">Referal</h5>
                      </div>
                      <div class="card-body">
                        <h6 class="mb-3">Refer your friends and earn money!</h6>
                        <p>Share this link: <strong>
                            <%= user?.referalCode %>
                          </strong></p>
                        <p>Earned: ₹<%= user?.referalPoints %>
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
    </section>
  </main>


  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>

document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".retry-payment").forEach(button => {
        button.addEventListener("click", async function () {
            const orderId = this.getAttribute("data-order-id");

            try {
                const response = await fetch("/retry-payment", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ orderId }),
                });

                const data = await response.json();

                if (!data.success) {
                    Swal.fire({
                        icon: "error",
                        title: "Retry Failed",
                        text: data.message,
                        showConfirmButton: true,
                    });
                    return;
                }

                const options = {
                    key: "rzp_test_FgtVyF2A1Al0K2",
                    amount: data.order.amount,
                    currency: data.order.currency,
                    name: "KICKKART",
                    description: "Order Payment",
                    order_id: data.order.id,
                    handler: async function (response) {
                        try {
                            const verifyResponse = await fetch("/verify-payment", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({
                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_signature: response.razorpay_signature,
                                }),
                            });

                            const verifyData = await verifyResponse.json();

                            if (verifyData.success) {
                                Swal.fire({
                                    icon: "success",
                                    title: "Payment Successful!",
                                    text: "Your payment was successful, and your order has been placed.",
                                    timer: 3000,
                                    timerProgressBar: true,
                                    showConfirmButton: false,
                                });

                                setTimeout(() => {
                                    window.location.href = "/userProfile";
                                }, 3000);
                            } else {
                                Swal.fire({
                                    icon: "error",
                                    title: "Payment Verification Failed",
                                    text: "Your payment could not be verified. Please contact support.",
                                    showConfirmButton: true,
                                });
                            }
                        } catch (error) {
                            console.error("Error verifying payment:", error);
                        }
                    },
                    prefill: {
                        name: "User Name",
                        email: "user@example.com",
                        contact: "9999999999",
                    },
                    theme: { color: "#3399cc" }
                };

                const rzp1 = new Razorpay(options);
                rzp1.open();

            } catch (error) {
                console.error("Error retrying payment:", error);
            }
        });
    });
});


    function confirmDelete(deleteUrl) {
      Swal.fire({
        title: 'Are you sure?',
        text: "You won't be able to revert this!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Yes, delete it!'
      }).then((result) => {
        if (result.isConfirmed) {
          window.location.href = deleteUrl;
        }
      });
    }

    $('#exampleModalCenter').on('shown.bs.modal', function () {
      const currPassword = document.getElementById("currPassword");
      const password = document.getElementById("password");
      const confirmPassword = document.getElementById("confirm-password");

      // Check if all elements are retrieved successfully
      console.log(currPassword, password, confirmPassword);

      if (currPassword && password && confirmPassword) {
        document.getElementById("changePassword").addEventListener("submit", async function (e) {
          e.preventDefault();

          const currPasswordValue = currPassword.value;
          const passwordValue = password.value;
          const confirmPasswordValue = confirmPassword.value;

          // Your password change logic here
          if (!currPasswordValue || !passwordValue || !confirmPasswordValue) {
            console.log("All fields must be filled!");
            return;
          }

          if (passwordValue !== confirmPasswordValue) {
            Swal.fire({
              icon: "error",
              title: "Error",
              text: "Passwords do not match.",
            });
            return;
          }

          try {
            const response = await fetch("/change-password?id=<%=user._id %>", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ currPassword: currPasswordValue, password: passwordValue, confirmPassword: confirmPasswordValue }),
            });

            const result = await response.json();
            if (response.ok) {
              await Swal.fire({
                icon: "success",
                title: "Password Changed Successfully",
                text: result.message || "Your password has been updated.",
                timer: 1500,
                showConfirmButton: false,
              });

              location.reload(); // Reload to reflect changes
            } else {
              Swal.fire({
                icon: "error",
                title: "Error",
                text: result.message || "Failed to change the password. Please try again.",
              });
            }
          } catch (error) {
            console.error("Error changing password:", error);
            Swal.fire({
              icon: "error",
              title: "Error",
              text: "Something went wrong. Please try again later.",
            });
          }
        });
      } else {
        console.log("Form elements are missing!");
      }
    });

    function initiatePayment() {
      const amount = document.getElementById('walletAmount').value;

      if (amount <= 0) {
        alert("Please enter a valid amount.");
        return;
      }

      fetch('/addWallet/create-order', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ amount })
      })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            const options = {
              key: "rzp_test_FgtVyF2A1Al0K2",
              amount: data.amount * 100,
              currency: 'INR',
              name: 'KICKKART',
              description: 'Wallet Recharge',
              order_id: data.order_id,
              handler: function (response) {

                fetch('/addWallet/verify-payment', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                  },
                  body: JSON.stringify({
                    payment_id: response.razorpay_payment_id,
                    order_id: data.order_id,
                    amount,
                    razorpay_signature: response.razorpay_signature
                  })
                })
                  .then(res => res.json())
                  .then(response => {
                    if (response.success) {
                      alert('Payment successful and wallet updated!');
                      location.reload();
                    } else {
                      alert('Payment verification failed.');
                    }
                  });
              },
              prefill: {
                name: 'Your Name',
                email: 'email@example.com',
                contact: '1234567890',
              },
              theme: {
                color: '#F37254'
              }
            };

            const rzp1 = new Razorpay(options);
            rzp1.open();
          }
        });
    }
 
    document.getElementById("saveChangesButton").addEventListener("click", async function () {
      try {
        const userName = document.getElementById("userName");
        const userPhone = document.getElementById("userPhone");
        const nameError = document.getElementById("nameError");
        const phoneError = document.getElementById("phoneError");

        let isValid = true;

        if (userName.value.trim().length < 3) {
          nameError.classList.remove("d-none");
          isValid = false;
        } else {
          nameError.classList.add("d-none");
        }

        const phoneRegex = /^[0-9]{10}$/;
        if (!phoneRegex.test(userPhone.value.trim())) {
          phoneError.classList.remove("d-none");
          isValid = false;
        } else {
          phoneError.classList.add("d-none");
        }

        if (isValid) {
          const data = {
            name: userName.value.trim(),
            phone: userPhone.value.trim(),
          };


          const response = await fetch('/editProfile', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(data),
          });

          if (!response.ok) {
            throw new Error('Failed to update profile');
          }

          const result = await response.json();

          Swal.fire({
            icon: 'success',
            title: 'Profile Updated!',
            text: result.message || 'Your profile has been updated successfully.',
            position: 'top-end',
            timer: 1000,
            showConfirmButton: false,
            toast: true,
          });

          window.location.href = "/userProfile"
          $('#editProfileModalCenter').modal('hide');
        }
      } catch (error) {
        console.error('Error:', error);

        Swal.fire({
          icon: 'error',
          title: 'Update Failed',
          text: error.message || 'An error occurred while updating your profile. Please try again.',
          position: 'top-end',
          timer: 2000,
          showConfirmButton: false,
          toast: true,
        });
      }
    });

  </script>

  <%- include("../../views/partials/user/footer") %>